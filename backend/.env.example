# ===== LLM 配置(OpenAI 兼容接口,DeepSeek/智谱/OpenAI 均可) =====
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 思考型模型(如 deepseek-v4-pro)必须为 false:思考模式不支持强制 tool_choice,
# 结构化输出会 400。改成 true 即开启推理链,但行程生成节点会失败。
# 注:thinking 是 DeepSeek 专有参数,只在 LLM_BASE_URL 含 deepseek 时才会下发,
# 所以把 base_url 换成 OpenAI/智谱 也不会因为这个参数报 400。
LLM_THINKING=false

# ===== 高德开放平台 Web服务 Key: https://console.amap.com/ =====
# 必须是「Web服务」类型;前端地图用的是另一种「Web端(JS API)」Key,两者不通用
AMAP_API_KEY=你的高德key

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000
# 允许的前端来源(逗号分隔;生产部署时改)
# CORS_ORIGINS=http://localhost:5173

# ===== 数据库(可选,不配则用零配置 SQLite:backend/data/travel.db) =====
# MySQL:库不存在会自动创建;驱动 pymysql 已在 requirements.txt
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/travel?charset=utf8mb4
# PostgreSQL 示例(需自行 pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/travel
